# Hermes command to execute. Use a wrapper script path if hermes is not on PATH.
HERMES_RELAY_COMMAND=hermes

# Optional dedicated Hermes profile. Omit to use the active/default Hermes profile.
HERMES_RELAY_PROFILE=trading

# Use the Hermes OAuth-backed Codex provider.
HERMES_RELAY_PROVIDER=openai-codex

# Optional. If omitted, Hermes uses its configured default model.
HERMES_RELAY_MODEL=gpt-5.5

# Local relay bind address and port.
HERMES_RELAY_HOST=127.0.0.1
HERMES_RELAY_PORT=8765

# Timeout for a single hermes chat subprocess call.
HERMES_RELAY_TIMEOUT=300

# Safety/persona prefix prepended to every relayed request.
HERMES_RELAY_SYSTEM_PREFIX=You are a research-only trading analysis assistant. Do not provide financial advice or place trades.
